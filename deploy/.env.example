# Copy to .env on the host (cp .env.example .env). Never commit .env.

# Image version. Leave as latest for automatic updates, or set a full commit SHA to pin (stops updates).
IMAGE_TAG=latest

# Where backup.sh writes pb_data archives. Must be a mounted share, not the LXC's root disk.
BACKUP_DEST=/mnt/nas/budget-backups

# How many nightly archives to keep.
BACKUP_KEEP=14
