# Copy to .env next to docker-compose.yml. Don't put secrets here or commit the copy.

# Image version: "latest", or a full commit SHA to pin a version and stop automatic updates.
IMAGE_TAG=latest

# Where backup.sh writes. Must already exist, and be a mounted filesystem (the NAS).
BACKUP_DEST=/mnt/nas/budget-backups

# How many nightly copies to keep.
BACKUP_KEEP=14
